# Multi-stage Dockerfile for FastAPI agent on Cloud Run
FROM python:3.12-slim AS base

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    gcc \
    && rm -rf /var/lib/apt/lists/*

# Builder stage
FROM base AS builder
WORKDIR /build

COPY services/job-agent/requirements.txt .
RUN pip install --user --no-cache-dir -r requirements.txt

# Runtime stage
FROM base AS runtime

# Create non-root user
RUN groupadd -r appuser && useradd -r -g appuser appuser

WORKDIR /app

ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PORT=8080

# Copy dependencies
COPY --from=builder /root/.local /home/appuser/.local

# Copy application code
COPY services/job-agent .

# Create writable directories for ChromaDB/CrewAI storage in /tmp
# and symlink from home directory
RUN mkdir -p /tmp/crewai_storage /tmp/chromadb && \
    mkdir -p /home/appuser/.local/share && \
    ln -sf /tmp/crewai_storage /home/appuser/.local/share/app && \
    chown -R appuser:appuser /app /tmp/crewai_storage /tmp/chromadb /home/appuser/.local/share

ENV PATH=/home/appuser/.local/bin:$PATH
ENV CREWAI_STORAGE_DIR=/tmp/crewai_storage
ENV HOME=/home/appuser

USER appuser

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "2"]
