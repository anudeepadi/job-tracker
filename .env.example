# ==========================================
# UNIFIED ENVIRONMENT CONFIGURATION
# Jobs Project - Multi-Service Setup
# ==========================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env files with real credentials to version control.

# =============================================================================
# DATABASE CONFIGURATION (Prisma)
# =============================================================================
# For local Docker PostgreSQL:
DATABASE_URL="postgresql://jobtracker:jobtracker_dev_password@localhost:5432/jobtracker"

# For remote PostgreSQL (via Tailscale or direct):
# DATABASE_URL="postgresql://user:password@host:5432/database"

# =============================================================================
# AI API KEYS
# =============================================================================
# Anthropic Claude API (for AI agents)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API (alternative AI provider)
OPENAI_API_KEY=your_openai_api_key_here

# Google AI API (for Gemini)
GOOGLE_API_KEY=your_google_api_key_here

# =============================================================================
# JOB SEARCH APIs
# =============================================================================
# Adzuna Job Search API (REQUIRED) - Get keys from: https://developer.adzuna.com/
# Free tier available with 1000 calls/month
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_API_KEY=your_adzuna_api_key

# LinkedIn Jobs API (OPTIONAL) - Via RapidAPI
# Get your key from: https://rapidapi.com/jaypat87/api/linkedin-jobs-search
# Note: This is a paid service
LINKEDIN_RAPIDAPI_KEY=your_rapidapi_key_here

# JSearch API (OPTIONAL) - Via RapidAPI - Aggregates multiple job boards
# Get your key from: https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
# Aggregates from Indeed, LinkedIn, Glassdoor, ZipRecruiter, BeBee and more
# Free tier: 100 requests/month, then paid
JSEARCH_RAPIDAPI_KEY=your_jsearch_rapidapi_key_here

# RemoteOK API (OPTIONAL - FREE, NO AUTH REQUIRED)
# Focuses on remote-first tech positions
# Set to "true" to enable, "false" to disable
# Default: true (since it's free)
REMOTEOK_ENABLED=true

# =============================================================================
# INTERNAL SERVICE URLs
# =============================================================================
PYTHON_BACKEND_URL="http://localhost:8000"
NEXT_PUBLIC_API_URL="http://localhost:3000"

# =============================================================================
# JWT/AUTH CONFIGURATION
# =============================================================================
JWT_SECRET="your-secret-key-change-in-production-use-a-long-random-string"

# =============================================================================
# ENVIRONMENT
# =============================================================================
NODE_ENV=development
