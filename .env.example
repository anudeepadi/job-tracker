# ==========================================
# UNIFIED ENVIRONMENT CONFIGURATION
# Jobs Project - Multi-Service Setup
# ==========================================

# =============================================================================
# DATABASE CONFIGURATION (Prisma - job-tracker)
# =============================================================================
# PostgreSQL connection string for Prisma ORM
# Format: postgres://[user]:[password]@[host]:[port]/[database]?sslmode=require
# Get your database URL from your hosting provider (e.g., db.prisma.io)
DATABASE_URL="postgres://user:password@db.example.com:5432/jobs_db?sslmode=require"

# =============================================================================
# OPENAI API (job-search-agent - currently active)
# =============================================================================
# OpenAI API key for AI-powered job search intelligence
# Get your API key from: https://platform.openai.com/api-keys
# Model used: gpt-4o-mini
OPENAI_API_KEY="sk-proj-xxxxxxxxxxxxxxxxxxxxx"

# =============================================================================
# ANTHROPIC CLAUDE API (optional - not currently used)
# =============================================================================
# Claude API key - alternative to OpenAI
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY="sk-ant-xxxxxxxxxxxxxxxxxxxxx"

# =============================================================================
# ADZUNA JOB SEARCH API (job-search-agent)
# =============================================================================
# Adzuna API credentials for job listings and search
# Get your credentials from: https://developer.adzuna.com/
# Free tier: 250 API calls per month
ADZUNA_APP_ID="your_app_id"
ADZUNA_API_KEY="your_api_key"

# =============================================================================
# LINKEDIN JOBS API (via RapidAPI - optional)
# =============================================================================
# LinkedIn Jobs Search API for expanded job search
# Get your key from: https://rapidapi.com/jaypat87/api/linkedin-jobs-search
# Free tier: 100 requests/month
LINKEDIN_RAPIDAPI_KEY=""

# =============================================================================
# GOOGLE GEMINI API (AI Chat natural language parsing)
# =============================================================================
# Gemini API key for parsing natural language job search queries
# Get your API key from: https://aistudio.google.com/apikey
# Model used: gemini-2.0-flash-lite
GOOGLE_API_KEY="your_google_api_key"

# =============================================================================
# INTERNAL SERVICE URLs
# =============================================================================
# Python backend URL (job-search-agent service)
# Used by Next.js frontend to connect to the Python backend
PYTHON_BACKEND_URL="http://localhost:8000"

# Next.js frontend public API URL
# Used by frontend clients to access API endpoints
NEXT_PUBLIC_API_URL="http://localhost:3000"

# =============================================================================
# OPTIONAL: ADDITIONAL CONFIGURATION
# =============================================================================
# Environment mode
NODE_ENV="development"

# Database logging (optional - for Prisma)
# Options: query, info, warn, error
DATABASE_LOG_LEVEL="info"

# API rate limiting (optional)
# RATE_LIMIT_WINDOW_MS="900000"
# RATE_LIMIT_MAX_REQUESTS="100"

# Feature flags (optional)
# ENABLE_JOB_CACHING="true"
# CACHE_TTL_MINUTES="30"
