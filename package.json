{
  "name": "job-search-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Unified job search platform with AI-powered job tracking and analysis",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "dev": "bash scripts/start-dev.sh",
    "start": "bash scripts/start-prod.sh",
    "migrate-data": "bash scripts/migrate-data.sh",
    "dev:parallel": "pnpm run --parallel dev",
    "dev:web": "pnpm --filter web dev",
    "dev:agent": "cd services/job-agent && python -m uvicorn main:app --reload --port 8000",
    "build": "pnpm run --parallel build",
    "build:web": "pnpm --filter web build",
    "lint": "pnpm run --parallel lint",
    "test": "pnpm run --parallel test",
    "start:agent": "cd services/job-agent && python -m uvicorn main:app --host 0.0.0.0 --port 8000",
    "orchestrate": "cd orchestration && claude-flow start",
    "clean": "pnpm run --parallel clean && rm -rf node_modules"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "keywords": [
    "job-search",
    "ai-agent",
    "job-tracker",
    "monorepo"
  ],
  "author": "",
  "license": "MIT"
}
